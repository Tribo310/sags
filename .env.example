MONGO_URL=mongodb://localhost:27018/?directConnection=true
MONGO_DB=shop
# OyuLLM (OpenAI-compatible base URL from organisers)
LLM_BASE_URL=https://api.oyu.so/v1
LLM_API_KEY=
LLM_MODEL=oyuLLM
# OpenAI: sub-agents that suit it (procurement, advisor, store negotiators). Empty key -> they use OyuLLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Move an agent to another provider: MODEL_<ROLE>=oyullm|openai|ollama (roles: meal_planner, procurement,
# advisor, store). The manager always uses OyuLLM.
# Local fallback (Ollama)
FALLBACK_BASE_URL=http://localhost:11434/v1
FALLBACK_MODEL=qwen3:8b
# bge-m3 embeddings: local Ollama, or the oyu API (same vectors, faster): https://api.oyu.so/v1 + EMBED_API_KEY
EMBED_API_KEY=
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
EMBED_DIMS=1024
# OyuVoice speech to text: POST {OYUVOICE_URL}/audio/transcriptions (same key as OyuLLM works)
OYUVOICE_URL=https://api.oyu.so/v1
OYUVOICE_API_KEY=
# tsuurAI voice for reading replies aloud: mbspeech (Khalkha, default) · baseline · mn1h
TTS_VOICE=mbspeech
MCP_URL=http://localhost:8100/mcp
STORE_AGENT_URLS=http://localhost:9101,http://localhost:9102,http://localhost:9103
OSRM_URL=https://router.project-osrm.org
# Services bind to localhost only; set HOST=0.0.0.0 to expose them (no auth!)
HOST=127.0.0.1
# Ollama fallback: start the server with OLLAMA_CONTEXT_LENGTH=32768, the default context drops the system prompt
# Signs login JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 1 = auth cookies only over HTTPS (set when deployed behind TLS)
COOKIE_SECURE=
# Price scout: refreshes the real prices once a day at SCOUT_HOUR (Ulaanbaatar time), one planner process does it.
# SCOUT_DAILY=0 turns it off for this process (tests, extra dev instances).
SCOUT_DAILY=1
SCOUT_HOUR=3
